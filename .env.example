# Copia este archivo a .env y rellena los valores.
# API key de Tripo (https://platform.tripo3d.ai)
TRIPO_API_KEY=
# Contraseña de acceso (solo contraseña, sin usuario)
WEB_PASSWORD=
# Puerto HTTP (por defecto 3000)
PORT=3000
# Directorio de estado (por defecto ./data; en Docker /app/data)
DATA_DIR=
